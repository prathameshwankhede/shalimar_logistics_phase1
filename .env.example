# TransFlow Logistics — Hostinger Environment Variables

# Node.js Server & Environment
PORT=3000
NODE_ENV=production

# Hostinger Managed MySQL Connection (Supports DB_* or DATABASE_*)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=transflow_db
DB_USER=u123456789_transflow
DB_PASSWORD=your_hostinger_mysql_password

# Standard Aliases (Optional)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=transflow_db
DATABASE_USER=u123456789_transflow
DATABASE_PASSWORD=your_hostinger_mysql_password

# Authentication Secret
JWT_SECRET=your_random_secure_jwt_secret_2026

# Optional Frontend API Base URL (if backend is on a custom subdomain)
VITE_API_BASE_URL=
